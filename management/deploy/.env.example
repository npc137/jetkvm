# Required environment variables for docker-compose.
# Copy this file to .env and fill in the values before running docker compose up.

# ── Microsoft Entra ID ────────────────────────────────────────────────────────
# Found in: Azure Portal → App registrations → your app → Overview

# Your Azure AD / Entra ID tenant GUID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# The client (application) ID of your app registration.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Public URLs ───────────────────────────────────────────────────────────────

# The externally reachable hostname for the management plane.
# Used in connect URLs returned to the browser.
MANAGEMENT_HOST=kvm.company.com

# Full public base URL (used by the backend to build connect URLs).
PUBLIC_BASE_URL=https://kvm.company.com

# ── TLS / Let's Encrypt ───────────────────────────────────────────────────────

# Email address for Let's Encrypt ACME registration.
ACME_EMAIL=admin@company.com
